# Polymarket V2 self-custody — copy to `.env` and fill locally. NEVER paste the key in chat.
#   cp tools/.env.polymarket.example tools/.env   &&   edit tools/.env

# The MetaMask account that holds the funds (7702 smart acct). Funder = signer for sig_type 0.
POLYMARKET_FUNDER=0xEE2D0C138E3CBf7965f6F9e6D63e6EC81007B482

# Private key for 0xEE2D — export from MetaMask (Account details -> Show private key).
# Holds your live funds: keep it ONLY in this local file. Leave blank for read-only `status`.
POLYMARKET_PK=

# Optional: override RPC (defaults to public Polygon endpoints with failover)
# POLYGON_RPC=https://polygon-rpc.com

# --- Webshare proxy (defeats the CLOB geoblock on order placement) ---
# API token from dashboard.webshare.io > API > Keys. Enables fetch-list +
# sticky proxy-per-account + usage/health (`python3 webshare.py ...`).
WEBSHARE_API_KEY=
WEBSHARE_COUNTRY=CA          # preferred non-US exit country
WEBSHARE_ENABLED=1           # 0 = force the direct route
# Static fallback when no API key (bare host:port also accepted):
# WEBSHARE_PROXY_URL=http://user:pass@host:port
